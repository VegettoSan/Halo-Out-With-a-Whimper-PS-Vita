+    pub fn show_message_ext(&mut self, args: &[Value]) -> gml::Result<Value> {
+        let (message, button1, button2, button3) = expect_args!(args, [bytes, bytes, bytes, bytes])?;
+        #[cfg(windows)]
+        {
+            let message = self.decode_str(message.as_ref()).into_owned();
+            let labels = [button1, button2, button3].map(|s| self.decode_str(s.as_ref()).into_owned());
+            let result = platform::message_dialog::show(
+                self.window.hwnd() as isize,
+                &message,
+                [&labels[0], &labels[1], &labels[2]],
+            );
+            // Drain owner-window events dispatched by the modal loop, then consume
+            // dialog activation/dismissal input rather than leaking it into GML.
+            self.process_window_events();
+            self.input.keyboard_clear_all();
+            self.input.mouse_clear_all();
+            result.map(Value::from).map_err(|e| gml::Error::FunctionError("show_message_ext".into(), e.to_string()))
+        }
+        #[cfg(not(windows))]
+        {
+            let _ = (message, button1, button2, button3);
+            Err(gml::Error::FunctionError("show_message_ext".into(), "modal backend not implemented on this platform".into()))
+        }
     }
 
