+
+struct AudioStats {
+    underflows: AtomicU32,
+    max_callback_us: AtomicU32,
+    stop: AtomicBool,
+    enabled: bool,
+}
+
+extern "C" fn audio_underflow(outstream: *mut SoundIoOutStream) {
+    unsafe {
+        let param = (*outstream).userdata as *mut UdonCallbackParam;
+        if !param.is_null() {
+            (&(*param).stats).underflows.fetch_add(1, Ordering::Relaxed);
+        }
+    }
+}
+
+struct CallbackTimer<'a> { stats: &'a AudioStats, start: Option<Instant> }
+impl Drop for CallbackTimer<'_> {
+    fn drop(&mut self) {
+        if let Some(start) = self.start {
+            self.stats.max_callback_us.fetch_max(start.elapsed().as_micros().min(u32::MAX as u128) as u32,
+                                                Ordering::Relaxed);
+        }
+    }
 }
 
